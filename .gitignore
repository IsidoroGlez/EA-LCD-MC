############################
# Compilation artifacts
############################
*.o
*.obj
*.out
*.exe
*.so
*.a
*.dll

**/bin/
**/obj/

############################
# Execution and temporary files
############################
*.tmp
*.swp
*.bak
*~
*.log
*.aux
*.tex
*.eps

############################
# Data files
############################

# Generic raw data files (not archived)
*.dat

############################
# Figures and tables
############################

# Exclude DATA directories inside figures and tables
FIGURES_AND_TABLES/**/DATA/

# Keep the generated tables (the generic *.tex / *.dat rules above would hide them)
!FIGURES_AND_TABLES/Tables/*/table.tex
!FIGURES_AND_TABLES/Tables/xi_summary/xi_summary.dat

############################
# Synchronization / auxiliary scripts
############################

sync.sh
update_data_and_figures.sh

############################
# OS-specific files
############################
.DS_Store
Thumbs.db
