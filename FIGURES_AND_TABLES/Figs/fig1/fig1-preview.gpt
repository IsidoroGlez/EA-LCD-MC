reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=1.  # One column
# R chosen so the x:z per-unit cell aspect matches the original 8-panel
# figure (x spanned 8 values across a narrow panel, z spanned 513 values
# across the full height) -- not a literal square, just the same "shape".
R=0.2775
load "../../PNAS_term.gpt"

#############
# OUTPUT
############
set output "fig1-preview.tex"

############
# DATA
###########

dir="DATA/"
y0=4  # only the y=4 slice is shown

set style fill solid 1.0 noborder

# z horizontal (left to right), x vertical (top to bottom, reversed)
set xrange [-0.5:512.5]
set yrange [7.5:-0.5]

set xlabel '\footnotesize $z$' offset 0,1.2
set ylabel '\footnotesize $x$' offset 3.5
set xtics 0,64,514 offset 0,0.5
set ytics 1,2,8 offset 0.75
set format x '\footnotesize $%.0f$'
set format y '\footnotesize $%.0f$'

set tics scale 0
unset key
unset colorbox

set tmargin screen 0.9254
set bmargin screen 0.3976
set lmargin screen 0.11
set rmargin screen 0.96

plot "< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0000_001_n" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c3") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0001_001_n" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c2") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0002_001_p" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c7") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0003_001_n" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c4") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0004_001_p" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c8") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0005_001_p" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c1") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0006_001_p" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c5") not,\
"< awk '{if($2==".y0.") print $3,$1}' ".dir."cluster_0007_001_p" u 1:2:(0.5):(0.5) w boxxyerror lc rgb colorGet("c6") not


###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex fig1-preview.tex
!pdf2svg fig1-preview.pdf fig1-preview.svg
#!latex fig1-preview.tex
#!dvisvgm --no-fonts fig1-preview.dvi

!rm *.aux *.tex *conver* *.log *.eps *.dvi