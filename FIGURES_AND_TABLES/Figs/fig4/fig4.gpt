reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=1.  # One column
R=0.6897  # H ~ 6cm (common height across figures)
load "../../PNAS_term.gpt"

#############
# OUTPUT
############
set output "fig4.tex"

############
# DATA
###########

set multiplot

set tmargin screen 0.97
set bmargin screen 0.14

set lmargin screen 0.15
set rmargin screen 0.99

# C^(n)(r)/[C^(1)(r)]^n vs C^(1)(r):
# x,dx <- column 4,5 of the n=1 file ; y,dy <- column 4,5 of the n-th file
DFILE(n) = sprintf("DATA/OBC/INDEPENDENT/16x48/C_2nR_over_C_2R_Q_Q_n%d_NBLOCKS_16384.txt", n)
OBC(n,sel) = sprintf("< paste %s %s | awk '%s{print $4,$5,$11,$12}'", DFILE(0), DFILE(n), sel)

# One temperature per colour.  T=0.7 ($1==0), 0.8 ($1==3), 0.9 ($1==6),
# 1.0 ($1==9) and the critical point (interpolated rows, $1=="I", beta=0.9075)
NT=5
array TSEL[NT]
array TCOL[NT]
array TKEY[NT]

TSEL[1] = "($1==0)"                            ; TCOL[1] = "c6" ; TKEY[1] = '\scriptsize $0.7$'
TSEL[2] = "($1==3)"                            ; TCOL[2] = "c4" ; TKEY[2] = '\scriptsize $0.8$'
TSEL[3] = "($1==6)"                            ; TCOL[3] = "c2" ; TKEY[3] = '\scriptsize $0.9$'
TSEL[4] = "($1==9)"                            ; TCOL[4] = "c7" ; TKEY[4] = '\scriptsize $1.0$'
TSEL[5] = "(($1==\"I\")&&($2==0.9075))"        ; TCOL[5] = "c5" ; TKEY[5] = '\scriptsize $T_\mathrm{c}$'

set xlabel '\footnotesize $C^{(1)}(r)$' offset 0,1.0
set ylabel '\footnotesize $C^{(n)}(r)/[C^{(1)}(r)]^n$' offset 3.7

set yrange [1:200]
set xrange [0.02:0.5]

set xtics 0.1,0.1,0.4 offset 0,0.5
set ytics offset 0.5

set format '\footnotesize %g'

set logs

x0=2.1e-2

set label 1 '\scriptsize $n=2$' left at x0,4.1
set label 2 '\scriptsize $n=3$' left at x0,23
set label 3 '\scriptsize $n=4$' left at x0,175

set label 4 '\scriptsize $T_\mathrm{c}=1.1019(29)$' left at 2.4e-2,1.28

set key at graph 0.985, graph 0.92 right top spacing 1.1 samplen 1 \
    title '\scriptsize $T$\\[0.5em]'

set object 100 rect from 0.055,17 to 0.059,20 front lw 1 fc rgb "gray" fillstyle empty

plot \
for [i=1:NT] OBC(1,TSEL[i]) u 1:3:2:4 w xyerror pt 0 lc rgb colorGet(TCOL[i]) notitle, \
for [i=1:NT] OBC(2,TSEL[i]) u 1:3:2:4 w xyerror pt 0 lc rgb colorGet(TCOL[i]) notitle, \
for [i=1:NT] OBC(3,TSEL[i]) u 1:3:2:4 w xyerror pt 0 lc rgb colorGet(TCOL[i]) notitle, \
for [i=1:NT] NaN w l lw 6 lc rgb colorGet(TCOL[i]) title TKEY[i]

unset object
unset ylabel
unset xlabel
unset label
unset key

set tmargin screen 1
set bmargin screen 0.6
set lmargin screen 0.4
set rmargin screen 0.8

unset logs

set xrange [0.055:0.059]
set yrange [17:20]

# # First block (black), bottom to top

x=0.0564
dx=0.0001
y=18.1
dy=0.1
do for[i=0:9]{
   if ( (i%2)==0 ){
      set object (i+1) rect from x-dx,y to x,y+dy fc rgb "black"
      set object (i+11) rect from x,y to x+dx,y+dy fc rgb "white"
   } else {
      set object (i+1) rect from x-dx,y to x,y+dy fc rgb "white"
      set object (i+11) rect from x,y to x+dx,y+dy fc rgb "black"
   }
   y=y+dy
}

set label 100 '\scriptsize $1$' center at x-0.0003, y-10*dy+0.5 rotate

x=0.0565
dx=0.0001
y=17.9
dy=0.1
do for[i=0:9]{
   if ( (i%2)==0 ){
      set object (i+21) rect from x,y to x+dx,y+dy fc rgb "black"
      set object (i+31) rect from x,y+dy to x+dx,y+2*dy fc rgb "white"
   } else {
      set object (i+21) rect from x,y to x+dx,y+dy fc rgb "white"
      set object (i+31) rect from x,y+dy to x+dx,y+2*dy fc rgb "black"
   }
   x=x+dx
}
set label 200 '\scriptsize $1 \times 10^{-3}$' center at x-2*dx, y-0.17

set object 200 rect from 0.0555,17.5 to 0.0585,19.5 front lw 1 fc rgb "gray" fillstyle empty

unset border
unset tics

set arrow 1 nohead from 0.0555,19.5 to screen 0.4104,screen 0.6142
set arrow 2 nohead from 0.0585,17.5 to screen 0.4286, screen 0.5888

replot

unset multiplot

###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex fig4.tex
!latex fig4.tex
!dvisvgm --no-fonts fig4.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
