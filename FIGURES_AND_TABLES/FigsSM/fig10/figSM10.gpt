reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0

###############
# PNAS TERMINAL
###############
C=1.  # One column
R=0.6897  # kept as in the two-column layout (unchanged per request)
load "../../style/ealcd_pnas.gpt"

#############
# OUTPUT
############
set output "figSM10.tex"

############
# DATA
###########

# T=0.7 is a directly simulated temperature (index 0, beta=1/0.7) stored in
# the same raw xi12/xi files Figs/fig2/fig2.gpt reads for xi(T_c); reuse its
# blocking-level constants d4..d24 for consistency across figures.
d4=5
d6=6
d8=8
d12=12
d16=8
d24=8

data_T07="DATA/xi_T07.dat"
cmd=sprintf("awk '($1==0)&&($3==%d){print 4,$4,$5}' DATA/PBC/4x192/xi12_Q_Q_n0_NBLOCKS_32768.txt > DATA/xi_T07.dat" , d4)
system cmd
cmd=sprintf("awk '($1==0)&&($3==%d){print 6,$4,$5}' DATA/PBC/6x192/xi12_Q_Q_n0_NBLOCKS_32768.txt >> DATA/xi_T07.dat" , d6)
system cmd
cmd=sprintf("awk '($1==0)&&($3==%d){print 8,$4,$5}' DATA/PBC/8x192/xi12_Q_Q_n0_NBLOCKS_32768.txt >> DATA/xi_T07.dat" , d8)
system cmd
cmd=sprintf("awk '($1==0)&&($3==%d){print 12,$4,$5}' DATA/PBC/12x320/xi12_Q_Q_n0_NBLOCKS_32768.txt >> DATA/xi_T07.dat" , d12)
system cmd
cmd=sprintf("awk '($1==0)&&($3==%d){print 16,$4,$5}' DATA/OBC/INDEPENDENT/16x48/xi_Q_Q_n0_NBLOCKS_16384.txt >> DATA/xi_T07.dat" , d16)
system cmd
cmd=sprintf("awk '($1==0)&&($3==%d){print 24,$4,$5}' DATA/OBC/INDEPENDENT/24x88/xi_Q_Q_n0_NBLOCKS_2048.txt >> DATA/xi_T07.dat" , d24)
system cmd

set lmargin screen 0.16
set rmargin screen 0.99
set tmargin screen 0.97
set bmargin screen 0.14

set xlabel '\footnotesize $L$' offset 0,1.0
set ylabel '\footnotesize $\xi\,(T=0.7,L)$' offset 3.2

set format '\footnotesize $%g$'

set logs

set xrange [3.5:27.5]
set yrange [7:86.8]

unset xtics
set xtics (4,6,8,12,16,24) offset 0,0.5
unset ytics
set ytics (10,20,30,40,50,60,70,80) offset 0.75

set errorbars 3

set label 1 '\footnotesize Fit to $\xi\,(T\!=\!0.7,L) = b_1 L^{\,4/3} + b_2 L$' left at 3.9,70

r=4./3
f(x)=b1*x**r+b2*x
b1=0.7
b2=1.
fit [6:*] f(x) data_T07 u 1:2:3 yerror via b1,b2

# Diagnostic free-exponent cross-checks (not plotted): local effective
# exponent at small and large L, cf. the xmin-scan reasoning behind fig2.gpt.
g(x)=c1*x**c2
c1=1
c2=1.3
fit [3:9] g(x) data_T07 u 1:2:3 yerror via c1,c2

h(x)=d1*x**d2
d1=1
d2=1.3
fit [11:25] h(x) data_T07 u 1:2:3 yerror via d1,d2

plot \
data_T07 u 1:2:3 w yerror pt 0 lc rgb colorGet("c6") not,\
data_T07 u 1:2 w points pt 7 ps 1 lc rgb colorGet("c6") not,\
[6:24] f(x) lc rgb colorGet("c5") not,\
[4:6] f(x) dt 2 lc rgb colorGet("c5") not

###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!xelatex figSM10.tex
!dvisvgm --pdf --no-fonts figSM10.pdf
!rm -f *.aux *.tex *.log *.eps
