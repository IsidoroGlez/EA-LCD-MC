reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=2.  # Two columns (scaled to \textwidth in the SM)
R=0.6897  # same R as main-text figs -> H ~ 12.28cm at C=2 (preserves aspect ratio)
load "../../PNAS_term.gpt"
set border lw 2.5
set tics scale 1.5,0.75

#############
# OUTPUT
############
set output "figSM2.tex"

############
# DATA
MET="DATA/averages_b00.12x320_128_M.txt"
HOU="DATA/averages_b00.12x320_128_C.txt"
###########

set lmargin screen 0.1051
set rmargin screen 0.9951
set tmargin screen 0.975
set bmargin screen 0.10

set xlabel '\normalsize EMCS' offset 0,0.3
set ylabel '\normalsize $q^2$' offset 2.45,0

nummed=1000  #measurements per file
v=12**2*320

set log x

set xrange [nummed:3e6]
set yrange [0.01:0.095]
set ytics 0.02 0.02 offset 0.55,0
set xtics offset 0,0.28
set format x '\normalsize $10^{%L}$'
set format y '\normalsize $%g$'
unset key

set label 1 '\normalsize PT' at 5*10**5, 0.04
set label 2 '\normalsize PT+HM' at 3*10**4, 0.08

f(x)=-0.079901+0.00982972*log(x)
g(x)=-0.152958+0.0238554*log(x)
a=0.0898881
p MET u ($1*nummed):(($15-$16)/v):(($15+$16)/v) w filledcurves lc rgb colorGet("c6") t "PT",\
HOU u ($1*nummed):(($15-$16)/v):(($15+$16)/v) w filledcurves lc rgb colorGet("c2") t "PT+HM",\
f(x) dt 3 lw 2.5 lc rgb "black" not, g(x) dt 3 lw 2.5 lc rgb "black" not, a dt 3 lw 2.5 lc rgb "black" not

###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex figSM2.tex
!latex figSM2.tex
!dvisvgm --no-fonts figSM2.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
