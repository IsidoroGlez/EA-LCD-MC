reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=2.  # Two columns (scaled to \textwidth in the SM)
R=0.6897  # same R as main-text figs -> H ~ 12.28cm at C=2 (preserves aspect ratio)
load "../../PNAS_term.gpt"
set border lw 2.5
set tics scale 1.5,0.75

#############
# OUTPUT
############
set output "figSM4.tex"

############
# DATA
###########

PBC="DATA/PBC/16x512/C_Q_Q_n0_NBLOCKS_1024.txt"
OBC="DATA/OBC/INDEPENDENT/16x48/Matrix_Q_Q_n0_NBLOCKS_16384.txt"

CMD=sprintf("awk '{if(($1==0)&&($3==0)){print $4}}' %s", PBC)
C0_PBC=system(CMD)
CMD=sprintf("awk '{if(($1==0)&&($3==0)){print $5}}' %s", PBC)
C0_PBC_err=system(CMD)

set lmargin screen 0.11
set rmargin screen 0.9951
set tmargin screen 0.975
set bmargin screen 0.10

set xlabel '\normalsize $z$' offset 0,0.3
set ylabel '\normalsize $C^{(1)}(z,z)$' offset 2.25

set ytics offset 0.5

set label 1 '\normalsize PBC, $M\!=\!512$' left at -0.5, 0.4491
set label 2 '\normalsize OBC, $M\!=\!48$' center at 13, 0.443

set arrow 2 nohead from 9, 0.443 to 4,0.4442 lw 1.3

set format y '\normalsize $%.2f$'
set format x '\normalsize $%.0f$'

set xtics 0,5,45 offset 0,0.4

set ytics add ("" 0.442, "" 0.444, "" 0.446, "" 0.448, "" 0.452, "" 0.454)

set xrange [-1:48]
set yrange [0.44:0.452]

ymin = C0_PBC - C0_PBC_err
ymax = C0_PBC + C0_PBC_err
y = C0_PBC + 0. 

x1=-1
x2=48

set object 1 rect from x1,ymin to x2,ymax fc rgb "#aaccee" fs solid 0.4 back

# White-disc-free plotting (see PARI Figs/fig3): the error-bar style draws an
# opaque white disc behind each point that masks neighbouring data / the
# reference line.  Plot in passes: (1) error bars with pt 0 (no disc), then the
# black reference line, then (2) the markers with "points" on top.
plot \
"< awk '$1==0{i=int($3/48);j=$3-i*48;if(i==j)print i,$4,$5}' ".OBC u 1:2:3 w yerror pt 0 lw 1.3 lc rgb colorGet("c2") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if(i==j)print i,$4,$5}' ".OBC u 1:2 w points pt 9 ps 2.5 lc rgb colorGet("c2") not,\
y w line lw 2.0 lc rgb "black" not

###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex figSM4.tex
!latex figSM4.tex
!dvisvgm --no-fonts figSM4.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
