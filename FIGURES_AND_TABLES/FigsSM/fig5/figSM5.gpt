reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=2.  # Two columns (scaled to \textwidth in the SM)
R=0.6897  # same R as main-text figs -> H ~ 12.28cm at C=2 (preserves aspect ratio)
load "../../PNAS_term.gpt"
set border lw 2.5
set tics scale 1.5,0.75

#############
# OUTPUT
############
set output "figSM5.tex"

############
# DATA
###########

PBC="DATA/PBC/16x512/C_Q_Q_n0_NBLOCKS_1024.txt"
OBC="DATA/OBC/INDEPENDENT/16x48/Matrix_Q_Q_n0_NBLOCKS_16384.txt"

set lmargin screen 0.11
set rmargin screen 0.9951
set tmargin screen 0.975
set bmargin screen 0.10

set xlabel '\normalsize $r$' offset 0,0.3
set ylabel '\normalsize $C^{(1)}(z,z+r)$' offset 2.25

set xtics offset 0,0.4
set ytics offset 0.5

set label 1 '\normalsize PBC' right at 49.5, 0.135
set label 2 '\normalsize $z=5$' right at 41.5, 0.1575
set label 3 '\normalsize $z=15$' right at 31.5, 0.20
set label 4 '\normalsize $z=25$' right at 21.5, 0.2525
set label 5 '\normalsize $z=35$' right at 11.5, 0.32

set format y '\normalsize $%.2f$' 
set format x '\normalsize $%.0f$'

set xtics 0,5,45

set xrange [-1:50]
set yrange [*:*]

# White-disc-free plotting (see PARI Figs/fig3): the error-bar style draws an
# opaque white disc behind each point that masks neighbouring data.  Plot in
# passes: (1) error bars with pt 0 (no disc), (2) the markers with "points".
plot \
"< awk '$1==0{print $3,$4,$5}' ".PBC u 1:2:3 w yerror pt 0 lw 1.3 lc rgb colorGet("c2") not,\
"< awk '$1==0{print $3,$4,$5}' ".PBC u 1:2 w points pt 7 ps 1.5 lc rgb colorGet("c2") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==5)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2:3 w yerror pt 0 lw 1.3 lc rgb colorGet("c3") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==5)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2 w points pt 9 ps 1.5 lc rgb colorGet("c3") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==15)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2:3 w yerror pt 0 lw 1.3 lc rgb colorGet("c5") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==15)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2 w points pt 11 ps 1.5 lc rgb colorGet("c5") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==25)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2:3 w yerror pt 0 lw 1.3 lc rgb colorGet("c4") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==25)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2 w points pt 5 ps 1.3 lc rgb colorGet("c4") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==35)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2:3 w yerror pt 0 lw 1.3 lc rgb colorGet("c8") not,\
"< awk '$1==0{i=int($3/48);j=$3-i*48;if((i==35)&&(j>=i)){print j-i,$4,$5}}' ".OBC u 1:2 w points pt 13 ps 1.5 lc rgb colorGet("c8") not

###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex figSM5.tex
!latex figSM5.tex
!dvisvgm --no-fonts figSM5.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
