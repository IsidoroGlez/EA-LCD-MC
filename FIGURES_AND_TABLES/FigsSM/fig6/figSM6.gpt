reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=2.  # Two columns (scaled to \textwidth in the SM)
R=0.6897  # same R as main-text figs -> H ~ 12.28cm at C=2 (preserves aspect ratio)
load "../../PNAS_term.gpt"
set border lw 2.5
set tics scale 1.5,0.75

#############
# OUTPUT
############
set output "figSM6.tex"

############
# DATA
###########

L24_MIN_0="< awk '($1==0) && $($4==\"nan\"){print $3,$4,$5}' DATA/OBC/INDEPENDENT/24x88/xi_2R_over_xi_MIN_Q3signQ_n0_NBLOCKS_2048.txt"
L24_MIN_1="< awk '($1==0) && $($4==\"nan\"){print $3,$4,$5}' DATA/OBC/INDEPENDENT/24x88/xi_2R_over_xi_MIN_signQQ_n0_NBLOCKS_2048.txt"
L24_MIN_2="< awk '($1==0) && $($4==\"nan\"){print $3,$4,$5}' DATA/OBC/INDEPENDENT/24x88/xi_2R_over_xi_MIN_QQ3_n0_NBLOCKS_2048.txt"

L16_MIN_0="< awk '($1==0) && $($4==\"nan\"){print $3,$4,$5}' DATA/OBC/INDEPENDENT/16x48/xi_2R_over_xi_MIN_Q3signQ_n0_NBLOCKS_16384.txt"
L16_MIN_1="< awk '($1==0) && $($4==\"nan\"){print $3,$4,$5}' DATA/OBC/INDEPENDENT/16x48/xi_2R_over_xi_MIN_signQQ_n0_NBLOCKS_16384.txt"
L16_MIN_2="< awk '($1==0) && $($4==\"nan\"){print $3,$4,$5}' DATA/OBC/INDEPENDENT/16x48/xi_2R_over_xi_MIN_QQ3_n0_NBLOCKS_16384.txt"

set lmargin screen 0.0856
set rmargin screen 0.9951
set tmargin screen 0.975
set bmargin screen 0.10

set xlabel '\normalsize $r_{\mathrm{min}}$' offset 0,0.3
set ylabel '\normalsize $U$' offset 1.95

set format '\normalsize $%g$'

set xtics offset 0,0.4
set ytics offset 0.5
set xrange [-0.15:7]
set yrange [8:29]

set label 1 '\normalsize $\lbrace Q^3, \text{sign}(Q)\rbrace$' left at 0,13.2
set label 2 '\normalsize $\lbrace Q, \text{sign}(Q)\rbrace$' left at 0,11.7
set label 3 '\normalsize $\lbrace Q, Q^3\rbrace$' left at 0,10.2
set label 4 '\normalsize $L\!=\!24$' center at 1.5,14.5
set label 5 '\normalsize $L\!=\!16$' center at 2.2,14.5

# White-disc-free plotting (see PARI Figs/fig3): the yerror style draws an
# opaque white disc behind each point that masks neighbouring data.  Plot the
# yerror series in passes: (1) error bars with pt 0 (no disc), (2) the markers
# with "points".  The xerror legend markers are left unchanged.
plot \
L24_MIN_0 u 1:(1+$2):3 w yerror pt 0 lw 1.3 lc rgb colorGet("c2") not,\
L24_MIN_0 u 1:(1+$2) w points pt 7 ps 1.3 lc rgb colorGet("c2") not,\
"< echo '1.5 12.06 0.3'" u 1:(1+$2):3 w xerror pt 7 ps 2.0 lw 2.5 lc rgb colorGet("c2") not,\
L24_MIN_1 u ($1+0.15):(1+$2):3 w yerror pt 0 lw 1.3 lc rgb colorGet("c7") not,\
L24_MIN_1 u ($1+0.15):(1+$2) w points pt 5 ps 1.3 lc rgb colorGet("c7") not,\
"< echo '1.5 10.56 0.3'" u 1:(1+$2):3 w xerror pt 5 ps 2.0 lw 2.5 lc rgb colorGet("c7") not,\
L24_MIN_2 u ($1+0.30):(1+$2):3 w yerror pt 0 lw 1.3 lc rgb colorGet("c5") not,\
L24_MIN_2 u ($1+0.30):(1+$2) w points pt 13 ps 1.3 lc rgb colorGet("c5") not,\
"< echo '1.5 9.06 0.3'" u 1:(1+$2):3 w xerror pt 13 ps 2.5 lw 2.5 lc rgb colorGet("c5") not,\
L16_MIN_0 u ($1+0.45):(1+$2):3 w yerror pt 0 lw 1.3 lc rgb colorGet("c3") not,\
L16_MIN_0 u ($1+0.45):(1+$2) w points pt 6 ps 1.3 lc rgb colorGet("c3") not,\
"< echo '2.2 12.06 0.3'" u 1:(1+$2):3 w xerror pt 6 ps 2.0 lw 2.5 lc rgb colorGet("c3") not,\
L16_MIN_1 u ($1+0.60):(1+$2):3 w yerror pt 0 lw 1.3 lc rgb colorGet("c6") not,\
L16_MIN_1 u ($1+0.60):(1+$2) w points pt 4 ps 1.3 lc rgb colorGet("c6") not,\
"< echo '2.2 10.56 0.3'" u 1:(1+$2):3 w xerror pt 4 ps 2.0 lw 2.5 lc rgb colorGet("c6") not,\
L16_MIN_2 u ($1+0.75):(1+$2):3 w yerror pt 0 lw 1.3 lc rgb colorGet("c4") not,\
L16_MIN_2 u ($1+0.75):(1+$2) w points pt 12 ps 1.3 lc rgb colorGet("c4") not,\
"< echo '2.2 9.06 0.3'" u 1:(1+$2):3 w xerror pt 12 ps 2.5 lw 2.5 lc rgb colorGet("c4") not


###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex figSM6.tex
!latex figSM6.tex
!dvisvgm --no-fonts figSM6.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
