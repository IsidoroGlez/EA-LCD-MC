reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=2.  # Two columns (scaled to \textwidth in the SM)
R=0.6897  # same R as main-text figs -> H ~ 12.28cm at C=2 (preserves aspect ratio)
load "../../PNAS_term.gpt"
set border lw 2.5
set tics scale 1.5,0.75

#############
# OUTPUT
############
set output "figSM7.tex"

############
# DATA
###########

Lz32="./DATA/Lz32_xi01-xi12.txt"
Lz48="./DATA/Lz48_xi01-xi12.txt"
Lz64="./DATA/Lz64_xi01-xi12.txt"
Lz96="./DATA/Lz96_xi01-xi12.txt"
Lz128="./DATA/Lz128_xi01-xi12.txt"
Lz192="./DATA/Lz192_xi01-xi12.txt"

set lmargin screen 0.0856
set rmargin screen 0.9951
set tmargin screen 0.975
set bmargin screen 0.10

set xlabel '\normalsize $r_{\mathrm{min}}$' offset 0,0.3
set ylabel '\normalsize $\xi$' offset 1.7

set format x '\normalsize $%g$'

set xtics offset 0,0.4
unset ytics
set ytics 17.8,0.2 format "" offset 0.5
set ytics add ('\normalsize $18$' 18, '\normalsize $19$' 19)

set label 1 '\normalsize $M\!=\!96$' left at 25,18.3
set label 2 '\normalsize $M\!=\!128$' left at 25,18.15
set label 3 '\normalsize $M\!=\!192$' left at 25,18.

set label 4 '\normalsize $\xi_{01}$' center at 33,18.45
set label 5 '\normalsize $\xi_{12}$' center at 40,18.45

set xrange [-0.5:49]
set yrange [17.7:19.3]

# White-disc-free (see PARI Figs/fig3): the data series (Lz*) are split into
# (1) yerror with pt 0 -> error bars, no disc, and (2) "points" -> the markers.
# The hand-drawn xerror legend swatches KEEP their disc on purpose: it isolates
# each key marker from the data curves that pass behind it (they are not data).
plot \
Lz96 u 1:2:3 every 2 w yerror pt 0 lw 2.5 lc rgb colorGet("c8") not "96",\
Lz96 u 1:2 every 2 w points pt 6 ps 2.0 lw 2.5 lc rgb colorGet("c8") not,\
"< echo '33 18.3 2.5'" u 1:2:3 w xerror pt 6 ps 2.0 lw 2.5 lc rgb colorGet("c8") not,\
Lz96 u 1:4:5 every 2 w yerror pt 0 lw 2.5 lc rgb colorGet("c8") not "96",\
Lz96 u 1:4 every 2 w points pt 7 ps 2.0 lw 2.5 lc rgb colorGet("c8") not,\
"< echo '40 18.3 2.5'" u 1:2:3 w xerror pt 7 ps 2.0 lw 2.5 lc rgb colorGet("c8") not,\
Lz128 u 1:2:3 every 2 w yerror pt 0 lw 2.5 lc rgb colorGet("c6") not "128",\
Lz128 u 1:2 every 2 w points pt 8 ps 2.0 lw 2.5 lc rgb colorGet("c6") not,\
"< echo '33 18.15 2.5'" u 1:2:3 w xerror pt 8 ps 2.5 lw 2.5 lc rgb colorGet("c6") not,\
Lz128 u 1:4:5 every 2 w yerror pt 0 lw 2.5 lc rgb colorGet("c6") not "128",\
Lz128 u 1:4 every 2 w points pt 9 ps 2.0 lw 2.5 lc rgb colorGet("c6") not,\
"< echo '40 18.15 2.5'" u 1:2:3 w xerror pt 9 ps 3.0 lw 2.5 lc rgb colorGet("c6") not,\
Lz192 u 1:2:3 every 4 w yerror pt 0 lw 2.5 lc rgb colorGet("c7") not "192",\
Lz192 u 1:2 every 4 w points pt 10 ps 2.0 lw 2.5 lc rgb colorGet("c7") not,\
"< echo '33 18.0 2.5'" u 1:2:3 w xerror pt 10 ps 2.5 lw 2.5 lc rgb colorGet("c7") not,\
Lz192 u 1:4:5 every 4::2 w yerror pt 0 lw 2.5 lc rgb colorGet("c7") not "192",\
Lz192 u 1:4 every 4::2 w points pt 11 ps 2.0 lw 2.5 lc rgb colorGet("c7") not,\
"< echo '40 18.0 2.5'" u 1:2:3 w xerror pt 11 ps 3.0 lw 2.5 lc rgb colorGet("c7") not


###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex figSM7.tex
!latex figSM7.tex
!dvisvgm --no-fonts figSM7.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
