reset
set auto
set fit noerrorscaling

##############
#COLOR PALETE
##############
PALETTE=0
load "../../my_color_palette.gpt"

###############
# PNAS TERMINAL
###############
C=2.  # Two columns (scaled to \textwidth in the SM)
R=0.6897  # same R as main-text figs -> H ~ 12.28cm at C=2 (preserves aspect ratio)
load "../../PNAS_term.gpt"
set border lw 2.5
set tics scale 1.5,0.75

#############
# OUTPUT
############
set output "figSM8.tex"

############
# DATA
###########

L16="DATA/L16_shortM.tot"

set lmargin screen 0.11
set rmargin screen 0.9951
set tmargin screen 0.975
set bmargin screen 0.10

set xlabel '\normalsize $M$' offset 0,0.3
set ylabel '\normalsize $R(M)$' offset 2.3

set format '\normalsize $%g$'

set xtics offset 0,0.4
set ytics offset 0.5

set xrange [1:16.5]
set yrange [.74:1.0]
f(x)=a*exp(-x/xi)+b*exp(-x/xi2)
g(x)=a*exp(-x/xi)
xi=44
xi2=2
fit [:16] f(x) L16 u 2:9:10 yerr via a,b,xi,xi2

plot L16 u 2:9:10 w yerr pt 9 ps 2.5 lc rgb colorGet("c2") not,\
f(x) dt 2 lw 1.3 lc "black" not,\
g(x) lw 1.3 lc "black" not


###########
# CLOSE
###########

set out

#############
# CREATE PDF
#############
!pdflatex figSM8.tex
!latex figSM8.tex
!dvisvgm --no-fonts figSM8.dvi
!rm *.aux *.tex *conver* *.log *.eps *.dvi
